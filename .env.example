# Настройки AEDEXA. Скопируйте в .env и подставьте свои ключи.
# Сам .env в git не попадает (.gitignore: .env*).

# Featherless (OpenAI-совместимый API) - модель для 2D -> 3D и разбора подписей.
# Ошибки сервис присылает и с HTTP 200, строгую JSON-схему не поддерживает,
# модель бывает занята - это учтено в коде.
FEATHERLESS_API_KEY=
# Запасной ключ: только когда модель временно занята.
FEATHERLESS_API_KEY_2=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Сколько символов контекста чертежа отдавать модели на одном этапе.
RECONSTRUCTION_AI_CONTEXT_LENGTH=48000
