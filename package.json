{
  "name": "aedexa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "scripts": {
    "predev": "node scripts/copy-libredwg-wasm.mjs && npm run db:local",
    "dev": "vinext dev",
    "prebuild": "node scripts/copy-libredwg-wasm.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:local": "wrangler d1 migrations apply aedexa --local",
    "db:remote": "wrangler d1 migrations apply aedexa --remote",
    "check:drawings": "tsx scripts/check-drawings.ts",
    "test:unit": "node scripts/run-tests.mjs",
    "format": "prettier --write app worker scripts types",
    "format:check": "prettier --check app worker scripts types",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "tetra": "node scripts/capture-tetra.mjs"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.9",
    "delaunator": "^5.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/delaunator": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-xml-parser": "^5.11.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "type": "module"
}
